# NixOS Build Artifacts
# ビルド時に生成されるシンボリックリンク
result
result-*

# Backups
*.bak
*.bak_*
*.old

# Secrets
# 将来的に秘密情報を別ファイルにする場合用
secrets/

# 念のための保険
*.key
*.private
id_rsa
id_ed25519

# Local credentials and environment files (templates may be committed)
.env
.env.*
!.env.example
!.env.sample
credentials.json
credentials*.json
*.pem
*.p12
*.pfx
**/age/keys.txt

# Editor / Home Manager recovery copies and local backups
*.hm-bak
*.invalid.*
*.snapshot.*
/backups/
/recovery-cache/
